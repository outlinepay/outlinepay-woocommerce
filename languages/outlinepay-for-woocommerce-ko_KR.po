#. Plugin Name of the plugin
#: outlinepay-for-woocommerce.php
msgid "OutlinePay for WooCommerce"
msgstr "OutlinePay for WooCommerce"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: outlinepay-for-woocommerce.php
msgid "https://outlinepay.com"
msgstr "https://outlinepay.com"

#. Description of the plugin
#: outlinepay-for-woocommerce.php
msgid ""
"Accept Korean payment methods (cards, bank transfer, virtual accounts, "
"wallets) through your payment provider, connected by OutlinePay."
msgstr ""
"OutlinePay로 연결된 결제대행사를 통해 한국 결제수단(카드, 계좌이체, 가상계"
"좌, 간편결제)을 받습니다."

#. Author of the plugin
#: outlinepay-for-woocommerce.php includes/class-abilities.php:58
#: includes/class-admin-page.php:70 includes/class-admin-page.php:71
#: includes/class-admin-page.php:350 includes/class-self-check.php:842
msgid "OutlinePay"
msgstr "OutlinePay"

#: includes/class-abilities.php:59
msgid "The store's connection to OutlinePay and its payment provider."
msgstr "OutlinePay 및 결제대행사와 이 스토어의 연결입니다."

#: includes/class-abilities.php:73
msgid "Run the OutlinePay self-check"
msgstr "OutlinePay 자체 점검 실행"

#: includes/class-abilities.php:74
msgid ""
"Checks this store's OutlinePay connection, background jobs, payment methods, "
"currency and versions, and asks OutlinePay to check its side. Returns each "
"check with who acts next when it fails, and a diagnostic code to send to the "
"payment provider. Reads no shopper or order data. At most one run a minute."
msgstr ""
"이 스토어의 OutlinePay 연결, 백그라운드 작업, 결제수단, 통화, 버전을 점검하"
"고 OutlinePay 쪽 점검도 요청합니다. 각 점검 결과와 실패 시 조치할 곳, 결제대"
"행사에 보낼 진단 코드를 돌려줍니다. 구매자 정보와 주문 정보는 읽지 않습니다. "
"1분에 한 번까지 실행할 수 있습니다."

#: includes/class-abilities.php:85
msgid "Get the OutlinePay connection status"
msgstr "OutlinePay 연결 상태 조회"

#: includes/class-abilities.php:86
msgid ""
"Returns the saved OutlinePay connection (status, mode, payment provider, "
"installation id, connected since) and a summary of the last self-check. "
"Makes no network call."
msgstr ""
"저장된 OutlinePay 연결 정보(상태, 모드, 결제대행사, 설치 ID, 연결 시작일)와 "
"마지막 자체 점검 요약을 돌려줍니다. 네트워크 요청은 하지 않습니다."

#: includes/class-admin-page.php:98
msgid "Settings"
msgstr "설정"

#: includes/class-admin-page.php:209 includes/class-gateway.php:99
#: includes/class-site-health.php:193
msgid "Open the OutlinePay page"
msgstr "OutlinePay 페이지 열기"

#: includes/class-admin-page.php:219
msgid "This looks like a copy of your store."
msgstr "이 사이트는 스토어의 사본으로 보입니다."

#. translators: 1: address the store was connected at, 2: this site's address.
#: includes/class-admin-page.php:223
#, php-format
msgid "It was connected at %1$s. This site is %2$s."
msgstr "연결된 주소는 %1$s입니다. 이 사이트의 주소는 %2$s입니다."

#: includes/class-admin-page.php:228
msgid "OutlinePay is off here, so this copy cannot take real payments."
msgstr "이 사본에서 실제 결제를 받지 않도록 OutlinePay를 껐습니다."

#: includes/class-admin-page.php:244
msgid "Confirm the move"
msgstr "이전 확인"

#. translators: %s: this site's address.
#: includes/class-admin-page.php:248
#, php-format
msgid "Only confirm if %s is now your real store."
msgstr "%s가 이제 실제 스토어일 때만 확인하십시오."

#: includes/class-admin-page.php:252
msgid ""
"Payments turn back on at this address. OutlinePay sends payment updates to "
"this address from now on."
msgstr ""
"이 주소에서 결제가 다시 켜집니다. 앞으로 OutlinePay는 결제 소식을 이 주소로 "
"보냅니다."

#: includes/class-admin-page.php:257
msgid "Yes, my store moved here"
msgstr "네, 스토어를 이 주소로 옮겼습니다"

#: includes/class-admin-page.php:258
msgid "Cancel"
msgstr "취소"

#: includes/class-admin-page.php:263 includes/class-admin-page.php:268
msgid "Connect this copy separately"
msgstr "이 사본을 따로 연결"

#: includes/class-admin-page.php:264
msgid ""
"This removes the copied connection from this site only. Your live store "
"keeps working. You can then connect this site with its own connect code."
msgstr ""
"복사된 연결 정보를 이 사이트에서만 지웁니다. 실제 스토어는 그대로 작동합니"
"다. 그런 다음 이 사이트를 별도 연결 코드로 연결할 수 있습니다."

#: includes/class-admin-page.php:271 includes/class-admin-page.php:273
msgid "I moved my store to this address"
msgstr "스토어를 이 주소로 옮겼습니다"

#: includes/class-admin-page.php:272
msgid "Choose this if this site is now your real store."
msgstr "이 사이트가 이제 실제 스토어라면 선택하십시오."

#: includes/class-admin-page.php:354
msgid ""
"The saved connection can no longer be read. This happens when the site "
"security keys change. Disconnect, then connect again with a new code."
msgstr ""
"저장된 연결 정보를 더 이상 읽을 수 없습니다. 사이트 보안 키가 바뀌면 이런 일"
"이 생깁니다. 연결을 해제한 뒤 새 코드로 다시 연결하십시오."

#: includes/class-admin-page.php:388
msgid ""
"OutlinePay no longer accepts this store's connection. Payments are off. Ask "
"your payment provider for a new connect code, then disconnect and connect "
"again."
msgstr ""
"OutlinePay가 이 스토어의 연결을 더 이상 받지 않습니다. 결제가 꺼졌습니다. 결"
"제대행사에 새 연결 코드를 요청한 뒤 연결을 해제하고 다시 연결하십시오."

#: includes/class-admin-page.php:432
msgid "Connect your store"
msgstr "스토어 연결"

#: includes/class-admin-page.php:433
msgid ""
"Your payment provider gives you a connect code. Paste it here to start "
"taking payments."
msgstr ""
"결제대행사에서 연결 코드를 받습니다. 여기에 붙여 넣으면 결제를 받을 수 있습니"
"다."

#: includes/class-admin-page.php:434
msgid ""
"Connecting sends this store's address, its callback address and its software "
"versions to OutlinePay."
msgstr ""
"연결하면 이 스토어의 주소, 콜백 주소, 소프트웨어 버전이 OutlinePay로 전송됩니"
"다."

#: includes/class-admin-page.php:438
msgid "Connect code"
msgstr "연결 코드"

#: includes/class-admin-page.php:440
msgid "Connect"
msgstr "연결"

#: includes/class-admin-page.php:453
msgid "Connected"
msgstr "연결됨"

#: includes/class-admin-page.php:454
msgid "Disconnected by OutlinePay"
msgstr "OutlinePay에서 연결 해제됨"

#: includes/class-admin-page.php:455
msgid "Pending"
msgstr "대기 중"

#: includes/class-admin-page.php:457
msgid "Connection"
msgstr "연결"

#: includes/class-admin-page.php:459
msgid "Test mode"
msgstr "테스트 모드"

#: includes/class-admin-page.php:463
msgid "Status"
msgstr "상태"

#: includes/class-admin-page.php:464
msgid "Mode"
msgstr "모드"

#: includes/class-admin-page.php:464
msgid "Test. Your payment provider reverses test payments. Do not ship goods."
msgstr "테스트. 테스트 결제는 결제대행사가 취소합니다. 상품을 발송하지 마십시오."

#: includes/class-admin-page.php:464
msgid "Live"
msgstr "라이브"

#: includes/class-admin-page.php:465
msgid "Payment provider"
msgstr "결제대행사"

#: includes/class-admin-page.php:466
msgid "Installation"
msgstr "설치 ID"

#: includes/class-admin-page.php:467
msgid "Refunds"
msgstr "환불"

#: includes/class-admin-page.php:467
msgid "On"
msgstr "켜짐"

#: includes/class-admin-page.php:467
msgid "Off"
msgstr "꺼짐"

#: includes/class-admin-page.php:469
msgid "Connected since"
msgstr "연결 시각"

#: includes/class-admin-page.php:485
msgid "Self-check"
msgstr "자체 점검"

#: includes/class-admin-page.php:486
msgid ""
"Checks the connection between this store, OutlinePay and your payment "
"provider. No shopper or order details are checked or sent."
msgstr ""
"이 스토어와 OutlinePay, 결제대행사 사이의 연결을 점검합니다. 구매자 정보와 주"
"문 정보는 점검하거나 보내지 않습니다."

#: includes/class-admin-page.php:489
msgid "A check ran less than a minute ago."
msgstr "1분 이내에 이미 점검을 실행했습니다."

#: includes/class-admin-page.php:494
msgid "Diagnostic code"
msgstr "진단 코드"

#: includes/class-admin-page.php:496
msgid "Copied"
msgstr "복사했습니다"

#: includes/class-admin-page.php:496
msgid "Selected. Press Ctrl+C to copy."
msgstr "선택했습니다. Ctrl+C를 눌러 복사하세요."

#: includes/class-admin-page.php:496
msgid "Copy"
msgstr "복사"

#: includes/class-admin-page.php:498
msgid "Send this code to your payment provider if you need help."
msgstr "도움이 필요하면 이 코드를 결제대행사에 보내 주세요."

#. translators: %s: date and time of the last check.
#: includes/class-admin-page.php:502
#, php-format
msgid "Last run %s (daily check)."
msgstr "마지막 실행: %s (일일 점검)"

#. translators: %s: date and time of the last check.
#: includes/class-admin-page.php:502
#, php-format
msgid "Last run %s."
msgstr "마지막 실행: %s"

#: includes/class-admin-page.php:507
msgid "OutlinePay was not reached, so this code was made on this site."
msgstr "OutlinePay에 연결되지 않아 이 사이트에서 코드를 만들었습니다."

#: includes/class-admin-page.php:512
msgid "Result"
msgstr "결과"

#: includes/class-admin-page.php:513
msgid "Check"
msgstr "점검 항목"

#: includes/class-admin-page.php:514
msgid "Who acts next"
msgstr "조치할 곳"

#: includes/class-admin-page.php:520
msgid "Pass"
msgstr "통과"

#: includes/class-admin-page.php:521
msgid "Fail"
msgstr "실패"

#: includes/class-admin-page.php:528
msgid "No check has run yet."
msgstr "아직 실행한 점검이 없습니다."

#: includes/class-admin-page.php:534
msgid "Run check"
msgstr "점검 실행"

#: includes/class-admin-page.php:548 includes/class-admin-page.php:592
msgid "Save"
msgstr "저장"

#: includes/class-admin-page.php:573
msgid "Processing"
msgstr "처리 중"

#: includes/class-admin-page.php:574
msgid "On hold"
msgstr "보류 중"

#: includes/class-admin-page.php:576
msgid "Refunds and cancellations"
msgstr "환불 및 주문 취소"

#: includes/class-admin-page.php:578
msgid ""
"Refund card, foreign card, bank transfer, KakaoPay and NaverPay payments "
"from the order screen with the Refund button. Partial refunds work for card "
"payments only. Refund other payments in your payment provider's dashboard."
msgstr ""
"신용카드, 해외카드, 계좌이체, 카카오페이, 네이버페이 결제는 주문 화면의 환불 "
"버튼으로 환불합니다. 부분 환불은 신용카드 결제만 가능합니다. 다른 결제는 결제"
"대행사 관리 화면에서 환불하십시오."

#: includes/class-admin-page.php:580
msgid ""
"Your payment provider has not turned on refunds for this store. Refund "
"payments in your payment provider's dashboard. Shoppers cannot cancel paid "
"orders until refunds are on."
msgstr ""
"결제대행사가 이 스토어의 환불 기능을 켜지 않았습니다. 결제는 결제대행사 관리 "
"화면에서 환불하십시오. 환불 기능이 켜지기 전에는 구매자가 결제된 주문을 취소"
"할 수 없습니다."

#: includes/class-admin-page.php:585
msgid "Let shoppers cancel their own paid orders"
msgstr "구매자가 결제된 자신의 주문을 취소할 수 있도록 허용"

#: includes/class-admin-page.php:586
msgid ""
"Shoppers see Cancel in My Account when the order has one of these statuses "
"and nothing was refunded yet. Cancelling refunds the full payment and "
"cancels the order."
msgstr ""
"주문이 아래 상태 중 하나이고 아직 환불된 금액이 없으면 구매자의 내 계정에 취"
"소가 표시됩니다. 취소하면 결제 전액이 환불되고 주문이 취소됩니다."

#: includes/class-admin-page.php:587
msgid "Order statuses shoppers can cancel"
msgstr "구매자가 취소할 수 있는 주문 상태"

#: includes/class-admin-page.php:603
msgid "Payment methods"
msgstr "결제수단"

#: includes/class-admin-page.php:605
msgid ""
"Your payment provider has no methods enabled for this store yet. Reload this "
"page later."
msgstr ""
"결제대행사가 이 스토어에 아직 결제수단을 활성화하지 않았습니다. 나중에 이 페"
"이지를 새로 고치십시오."

#: includes/class-admin-page.php:608
msgid ""
"These are the methods your payment provider has enabled for your store. You "
"can hide any of them. To add a method, ask your payment provider."
msgstr ""
"결제대행사가 이 스토어에 활성화한 결제수단입니다. 원하는 수단을 숨길 수 있습"
"니다. 수단을 추가하려면 결제대행사에 요청하십시오."

#: includes/class-admin-page.php:612
msgid "Method"
msgstr "결제수단"

#: includes/class-admin-page.php:612 includes/class-gateway.php:83
msgid "Show at checkout"
msgstr "결제 화면에 표시"

#: includes/class-admin-page.php:619
msgid "Save methods"
msgstr "결제수단 저장"

#: includes/class-admin-page.php:633 includes/class-admin-page.php:638
msgid "Disconnect"
msgstr "연결 해제"

#: includes/class-admin-page.php:634
msgid ""
"Disconnecting turns off OutlinePay payments in this store. Reconnecting "
"needs a new connect code from your payment provider."
msgstr ""
"연결을 해제하면 이 스토어의 OutlinePay 결제가 꺼집니다. 다시 연결하려면 결제"
"대행사의 새 연결 코드가 필요합니다."

#: includes/class-admin-page.php:635
msgid "Disconnect this store from OutlinePay?"
msgstr "이 스토어를 OutlinePay에서 연결 해제하시겠습니까?"

#: includes/class-admin-page.php:672
msgid "Your store is connected."
msgstr "스토어가 연결되었습니다."

#: includes/class-admin-page.php:673
msgid "Your store is disconnected."
msgstr "스토어 연결이 해제되었습니다."

#: includes/class-admin-page.php:674
msgid "Payment methods saved."
msgstr "결제수단을 저장했습니다."

#: includes/class-admin-page.php:675
msgid "Enter the connect code from your payment provider."
msgstr "결제대행사에서 받은 연결 코드를 입력하십시오."

#: includes/class-admin-page.php:676
msgid ""
"This connect code is not valid. It may have expired or already been used. "
"Ask your payment provider for a new code."
msgstr ""
"유효하지 않은 연결 코드입니다. 만료되었거나 이미 사용되었을 수 있습니다. 결제"
"대행사에 새 코드를 요청하십시오."

#: includes/class-admin-page.php:677
msgid ""
"OutlinePay could not accept this store's address. The store must be "
"reachable over HTTPS from the internet."
msgstr ""
"OutlinePay가 이 스토어의 주소를 받을 수 없습니다. 스토어는 인터넷에서 HTTPS"
"로 접속할 수 있어야 합니다."

#: includes/class-admin-page.php:678
msgid "Too many connect attempts. Wait a minute and try again."
msgstr "연결 시도가 너무 많습니다. 1분 뒤 다시 시도하십시오."

#: includes/class-admin-page.php:679
msgid ""
"OutlinePay could not be reached. Check that this server can make outgoing "
"HTTPS requests, then try again."
msgstr ""
"OutlinePay에 접속할 수 없습니다. 이 서버가 외부로 HTTPS 요청을 보낼 수 있는"
"지 확인한 뒤 다시 시도하십시오."

#: includes/class-admin-page.php:680
msgid "The store could not be connected. Try again in a moment."
msgstr "스토어를 연결하지 못했습니다. 잠시 후 다시 시도하십시오."

#: includes/class-admin-page.php:681
msgid ""
"The copied connection is removed from this site. Your live store keeps "
"working."
msgstr ""
"복사된 연결 정보를 이 사이트에서 지웠습니다. 실제 스토어는 그대로 작동합니다."

#: includes/class-admin-page.php:682
msgid "This site no longer looks like a copy. Nothing changed."
msgstr "이 사이트는 더 이상 사본으로 보이지 않습니다. 바뀐 것은 없습니다."

#: includes/class-admin-page.php:683
msgid "This address is saved as your store. Payments are back on."
msgstr "이 주소를 스토어 주소로 저장했습니다. 결제가 다시 켜졌습니다."

#: includes/class-admin-page.php:684
msgid ""
"This address is saved as your store and payments are back on. OutlinePay "
"could not be told the new address yet. Open this page again later to retry."
msgstr ""
"이 주소를 스토어 주소로 저장했고 결제가 다시 켜졌습니다. 아직 OutlinePay에 "
"새 주소를 알리지 못했습니다. 나중에 이 페이지를 다시 열면 다시 시도합니다."

#: includes/class-admin-page.php:685
msgid "The check finished. The results are below."
msgstr "점검을 마쳤습니다. 결과는 아래에 있습니다."

#: includes/class-admin-page.php:686
msgid "Email setting saved."
msgstr "이메일 설정을 저장했습니다."

#: includes/class-admin-page.php:687
msgid "Cancellation setting saved."
msgstr "주문 취소 설정을 저장했습니다."

#: includes/class-admin-page.php:724
msgid "You do not have permission to change OutlinePay settings."
msgstr "OutlinePay 설정을 변경할 권한이 없습니다."

#. translators: %s: payment method name, such as Credit or debit card.
#: includes/class-gateway.php:36
#, php-format
msgid "OutlinePay: %s"
msgstr "OutlinePay: %s"

#: includes/class-gateway.php:39
msgid ""
"Takes payment through your payment provider, connected by OutlinePay. "
"Connect the store and choose which methods to show on the OutlinePay page."
msgstr ""
"OutlinePay로 연결된 결제대행사를 통해 결제를 받습니다. 스토어 연결과 표시할 "
"결제수단 선택은 OutlinePay 페이지에서 합니다."

#: includes/class-gateway.php:85
msgid "Show this method at checkout when your provider has it enabled"
msgstr "결제대행사가 활성화한 경우 이 결제수단을 결제 화면에 표시"

#: includes/class-gateway.php:133 includes/class-refunds.php:106
msgid "This order could not be found."
msgstr "주문을 찾을 수 없습니다."

#: includes/class-gateway.php:137 includes/class-gateway.php:281
msgid "This payment method is not available right now. Choose another method."
msgstr "지금은 이 결제수단을 사용할 수 없습니다. 다른 결제수단을 선택하십시오."

#: includes/class-gateway.php:144
msgid "The order total must be a whole number of won. Contact the store."
msgstr "주문 금액은 원 단위 정수여야 합니다. 스토어에 문의하십시오."

#: includes/class-gateway.php:167 includes/class-gateway.php:284
msgid "The payment could not be started. Try again in a moment."
msgstr "결제를 시작하지 못했습니다. 잠시 후 다시 시도하십시오."

#: includes/class-gateway.php:267
msgid "This order cannot be paid right now. Contact the store."
msgstr "지금은 이 주문을 결제할 수 없습니다. 스토어에 문의하십시오."

#: includes/class-gateway.php:274 includes/class-switch-guard.php:138
msgid ""
"A payment for this order is being reviewed. The store will contact you. Do "
"not pay again."
msgstr ""
"이 주문의 결제를 확인하고 있습니다. 스토어에서 연락드립니다. 다시 결제하지 마"
"십시오."

#: includes/class-gateway.php:277
msgid ""
"A payment for this order is already being opened. Wait a moment and try "
"again."
msgstr "이 주문의 결제가 이미 열리고 있습니다. 잠시 후 다시 시도하십시오."

#: includes/class-order-display.php:85 includes/class-order-display.php:135
msgid "View card receipt"
msgstr "카드 전표 보기"

#: includes/class-order-display.php:209
msgid "Test payment"
msgstr "테스트 결제"

#: includes/class-order-display.php:209
msgid "OutlinePay took this payment in test mode. Your payment provider reverses it. Do not ship goods."
msgstr ""
"OutlinePay가 테스트 모드로 받은 결제입니다. 결제대행사가 이 결제를 취소합니다. 상품을 발송하지 마십시오."

#: includes/class-order-display.php:235 includes/class-order-display.php:267
#: includes/class-order-display.php:274
msgid "Deposit details"
msgstr "입금 정보"

#: includes/class-order-display.php:236
msgid ""
"Your order ships after the deposit arrives. Deposit the exact order total to "
"this account."
msgstr ""
"입금이 확인되면 주문이 발송됩니다. 아래 계좌로 주문 금액을 정확히 입금하십시"
"오."

#: includes/class-order-display.php:238 includes/class-order-display.php:262
msgid "Bank"
msgstr "은행"

#: includes/class-order-display.php:239 includes/class-order-display.php:263
msgid "Account number"
msgstr "계좌번호"

#: includes/class-order-display.php:240 includes/class-order-display.php:264
msgid "Deposit by"
msgstr "입금 기한"

#: includes/class-order-sync.php:288
msgid "(test mode)"
msgstr "(테스트 모드)"

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:322
#, php-format
msgid ""
"OutlinePay payment %s was paid, but this order was already paid with another "
"payment method. The shopper paid twice. To refund the OutlinePay payment, "
"use your payment provider dashboard."
msgstr ""
"OutlinePay 결제 %s가 완료되었지만 이 주문은 이미 다른 결제수단으로 결제되었습"
"니다. 구매자가 두 번 결제했습니다. OutlinePay 결제를 환불하려면 결제대행사 관"
"리 화면을 이용하십시오."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:339
#, php-format
msgid "OutlinePay payment %s is paid."
msgstr "OutlinePay 결제 %s가 완료되었습니다."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:348
#, php-format
msgid ""
"OutlinePay payment %s was made for this order number from another copy of "
"this store, such as a staging site. It does not pay this order. Check it "
"before shipping."
msgstr ""
"OutlinePay 결제 %s는 스테이징 사이트 같은 이 스토어의 다른 사본에서 같은 주"
"문 번호로 결제되었습니다. 이 주문의 결제가 아닙니다. 발송 전에 확인하십시오."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:369
#, php-format
msgid ""
"OutlinePay payment %s reports paid, but the amount or currency does not "
"match this order. Check it before shipping."
msgstr ""
"OutlinePay 결제 %s가 완료로 보고되었지만 금액이나 통화가 이 주문과 다릅니다. "
"발송 전에 확인하십시오."

#: includes/class-order-sync.php:389
msgid "OutlinePay issued a virtual account. Waiting for the deposit."
msgstr "OutlinePay가 가상계좌를 발급했습니다. 입금을 기다립니다."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:403
#, php-format
msgid "OutlinePay payment %s expired before the deposit arrived."
msgstr "OutlinePay 결제 %s가 입금 전에 만료되었습니다."

#. translators: 1: OutlinePay payment id, 2: status such as failed or expired.
#: includes/class-order-sync.php:410
#, php-format
msgid "OutlinePay payment %1$s is %2$s. The order is waiting for payment."
msgstr "OutlinePay 결제 %1$s의 상태는 %2$s입니다. 주문은 결제를 기다립니다."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:425
#, php-format
msgid ""
"OutlinePay payment %s needs review: it was paid for a different amount than "
"ordered. OutlinePay has been alerted. Do not ship until it is settled."
msgstr ""
"OutlinePay 결제 %s는 확인이 필요합니다. 주문 금액과 다른 금액이 결제되었습니"
"다. OutlinePay에 알림이 갔습니다. 해결될 때까지 발송하지 마십시오."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:436
#, php-format
msgid ""
"OutlinePay payment %s is probably the shopper's real payment for this order. "
"The earlier payment came from another copy of this store. Check both "
"payments before you refund anything. The order stays on hold."
msgstr ""
"OutlinePay 결제 %s는 이 주문에 대한 구매자의 실제 결제일 가능성이 높습니다. "
"앞선 결제는 이 스토어의 다른 사본에서 왔습니다. 환불하기 전에 두 결제를 모두 "
"확인하십시오. 주문은 보류 상태로 유지됩니다."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:446
#, php-format
msgid ""
"OutlinePay payment %s was paid after this order was already paid. The "
"shopper paid twice. OutlinePay has been alerted. Refund the second payment "
"in your payment provider dashboard."
msgstr ""
"OutlinePay 결제 %s는 이 주문이 이미 결제된 뒤에 결제되었습니다. 구매자가 두 "
"번 결제했습니다. OutlinePay에 알림이 갔습니다. 두 번째 결제는 결제대행사 관"
"리 화면에서 환불하십시오."

#. translators: %s: OutlinePay payment id.
#: includes/class-order-sync.php:472
#, php-format
msgid ""
"The shopper chose another payment method for this order, but then paid "
"OutlinePay payment %s. The payment method is set back to OutlinePay."
msgstr ""
"구매자가 이 주문에 다른 결제수단을 선택한 뒤 OutlinePay 결제 %s를 완료했습니"
"다. 결제수단을 OutlinePay로 되돌렸습니다."

#: includes/class-plugin.php:90
msgid ""
"OutlinePay for WooCommerce needs WooCommerce to be installed and active."
msgstr ""
"OutlinePay for WooCommerce를 사용하려면 WooCommerce를 설치하고 활성화해야 합"
"니다."

#: includes/class-refunds.php:109 includes/class-refunds.php:321
msgid ""
"This store is not connected to OutlinePay. Refund this payment in your "
"payment provider's dashboard."
msgstr ""
"이 스토어는 OutlinePay에 연결되어 있지 않습니다. 이 결제는 결제대행사 관리 화"
"면에서 환불하십시오."

#: includes/class-refunds.php:113
msgid "Refund a whole number of won, more than zero."
msgstr "0보다 큰 원 단위 정수로 환불하십시오."

#: includes/class-refunds.php:117
msgid ""
"This order has no OutlinePay payment that can be refunded here. Refund it in "
"your payment provider's dashboard."
msgstr ""
"이 주문에는 여기에서 환불할 수 있는 OutlinePay 결제가 없습니다. 결제대행사 관"
"리 화면에서 환불하십시오."

#: includes/class-refunds.php:120 includes/class-shopper-cancel.php:219
msgid "This order is being updated. Try again in a moment."
msgstr "이 주문을 업데이트하는 중입니다. 잠시 후 다시 시도하십시오."

#: includes/class-refunds.php:127
msgid "The refund could not be started. Reload the order and try again."
msgstr "환불을 시작하지 못했습니다. 주문을 새로고침한 뒤 다시 시도하십시오."

#: includes/class-refunds.php:134
msgid ""
"This refund already went through and is on this order. Reload the page to "
"see it."
msgstr ""
"이 환불은 이미 처리되어 이 주문에 있습니다. 페이지를 새로고침하면 보입니다."

#: includes/class-refunds.php:151
msgid ""
"OutlinePay answered, but the answer could not be read. Check the order notes "
"in a few minutes before you try again."
msgstr ""
"OutlinePay가 응답했지만 응답을 읽지 못했습니다. 다시 시도하기 전에 몇 분 뒤 "
"주문 메모를 확인하십시오."

#: includes/class-refunds.php:167
msgid "This refund is already on this order. Reload the order to see it."
msgstr "이 환불은 이미 이 주문에 있습니다. 주문을 새로고침하면 보입니다."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay refund id.
#: includes/class-refunds.php:179
#, php-format
msgid "Refunded %1$s through OutlinePay (refund %2$s)."
msgstr "OutlinePay로 %1$s을 환불했습니다 (환불 %2$s)."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay refund id.
#: includes/class-refunds.php:191
#, php-format
msgid ""
"The payment provider refused a refund of %1$s (refund %2$s). Nothing was "
"refunded."
msgstr ""
"결제대행사가 %1$s 환불을 거절했습니다 (환불 %2$s). 환불된 금액은 없습니다."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay refund id.
#: includes/class-refunds.php:205
#, php-format
msgid ""
"OutlinePay is confirming a refund of %1$s with the payment provider (refund "
"%2$s). It will be added to this order once confirmed."
msgstr ""
"OutlinePay가 결제대행사와 %1$s 환불을 확인하고 있습니다 (환불 %2$s). 확인되"
"면 이 주문에 추가됩니다."

#: includes/class-refunds.php:210
msgid ""
"OutlinePay is confirming this refund with the payment provider. It will "
"appear on this order automatically once confirmed."
msgstr ""
"OutlinePay가 결제대행사와 이 환불을 확인하고 있습니다. 확인되면 이 주문에 자"
"동으로 표시됩니다."

#. translators: %s: amount such as 5,000 won.
#: includes/class-refunds.php:284
#, php-format
msgid ""
"OutlinePay did not answer a refund of %s. It may or may not have gone "
"through. Do not refund this amount in your payment provider's dashboard. If "
"it went through, it will appear on this order automatically, usually within "
"a few minutes. Reload this order to check. Refunding the same amount again "
"is safe: OutlinePay will not refund twice."
msgstr ""
"OutlinePay가 %s 환불 요청에 응답하지 않았습니다. 환불이 처리되었을 수도 있고 "
"아닐 수도 있습니다. 이 금액을 결제대행사 관리 화면에서 환불하지 마십시오. 환"
"불이 처리되었다면 보통 몇 분 안에 이 주문에 자동으로 표시됩니다. 확인하려면 "
"이 주문을 새로고침하십시오. 같은 금액을 다시 환불해도 안전합니다. OutlinePay"
"는 두 번 환불하지 않습니다."

#: includes/class-refunds.php:298
msgid ""
"OutlinePay did not answer. The refund may or may not have gone through. Wait "
"a minute and check the order notes. To try again, refund the same amount."
msgstr ""
"OutlinePay가 응답하지 않았습니다. 환불이 처리되었을 수도 있고 아닐 수도 있습"
"니다. 잠시 기다린 뒤 주문 메모를 확인하십시오. 다시 시도하려면 같은 금액을 환"
"불하십시오."

#: includes/class-refunds.php:302
msgid ""
"Refunds are paused for this store right now. Try again later, or refund in "
"your payment provider's dashboard."
msgstr ""
"지금은 이 스토어의 환불이 일시 중지되어 있습니다. 나중에 다시 시도하거나 결제"
"대행사 관리 화면에서 환불하십시오."

#: includes/class-refunds.php:304
msgid ""
"OutlinePay cannot refund this payment. Refund it in your payment provider's "
"dashboard."
msgstr ""
"OutlinePay는 이 결제를 환불할 수 없습니다. 결제대행사 관리 화면에서 환불하십"
"시오."

#: includes/class-refunds.php:306
msgid ""
"This payment method cannot be refunded from WooCommerce. Refund it in your "
"payment provider's dashboard."
msgstr ""
"이 결제수단은 WooCommerce에서 환불할 수 없습니다. 결제대행사 관리 화면에서 환"
"불하십시오."

#: includes/class-refunds.php:308
msgid ""
"Partial refunds work for card payments only. Refund the full amount, or "
"refund the rest in your payment provider's dashboard."
msgstr ""
"부분 환불은 신용카드 결제만 가능합니다. 전액을 환불하거나, 나머지는 결제대행"
"사 관리 화면에서 환불하십시오."

#: includes/class-refunds.php:310
msgid "This is more than what is left to refund."
msgstr "환불할 수 있는 남은 금액보다 많습니다."

#: includes/class-refunds.php:312
msgid ""
"Today's refund limit for this store is reached. Ask your payment provider."
msgstr "이 스토어의 오늘 환불 한도에 도달했습니다. 결제대행사에 문의하십시오."

#: includes/class-refunds.php:314
msgid "A shopper cancel must refund everything that is left on the payment."
msgstr "구매자 주문 취소는 결제에 남은 금액 전부를 환불해야 합니다."

#: includes/class-refunds.php:316
msgid ""
"OutlinePay already has a different refund with this refund's number. Reload "
"the order and check its refunds before you try again."
msgstr ""
"OutlinePay에 이 환불 번호로 된 다른 환불이 이미 있습니다. 다시 시도하기 전에 "
"주문을 새로고침하고 환불 내역을 확인하십시오."

#: includes/class-refunds.php:318
msgid ""
"Your payment provider has not turned on refunds for this store. Refund it in "
"your payment provider's dashboard."
msgstr ""
"결제대행사가 이 스토어의 환불 기능을 켜지 않았습니다. 결제대행사 관리 화면에"
"서 환불하십시오."

#: includes/class-refunds.php:323
msgid ""
"OutlinePay does not know this payment. Refund it in your payment provider's "
"dashboard."
msgstr ""
"OutlinePay에 이 결제 기록이 없습니다. 결제대행사 관리 화면에서 환불하십시오."

#: includes/class-refunds.php:325
msgid "OutlinePay could not accept this refund. Refund a whole number of won."
msgstr "OutlinePay가 이 환불을 받을 수 없습니다. 원 단위 정수로 환불하십시오."

#: includes/class-refunds.php:327
msgid ""
"OutlinePay did not accept this refund. Nothing was refunded. Refund it in "
"your payment provider's dashboard."
msgstr ""
"OutlinePay가 이 환불을 받지 않았습니다. 환불된 금액은 없습니다. 결제대행사 관"
"리 화면에서 환불하십시오."

#: includes/class-refunds.php:339
msgid "The payment provider did not accept this amount. Nothing was refunded."
msgstr "결제대행사가 이 금액을 받지 않았습니다. 환불된 금액은 없습니다."

#: includes/class-refunds.php:341
msgid ""
"The payment provider refused this refund. Nothing was refunded. Refund it in "
"your payment provider's dashboard."
msgstr ""
"결제대행사가 이 환불을 거절했습니다. 환불된 금액은 없습니다. 결제대행사 관리 "
"화면에서 환불하십시오."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay refund id.
#: includes/class-refunds.php:379
#, php-format
msgid ""
"The payment provider did not complete the refund of %1$s (refund %2$s). "
"Nothing was refunded."
msgstr ""
"결제대행사가 %1$s 환불을 완료하지 않았습니다 (환불 %2$s). 환불된 금액은 없습"
"니다."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay payment id.
#: includes/class-refunds.php:400
#, php-format
msgid ""
"OutlinePay cancelled the duplicate payment %2$s automatically. %1$s went "
"back to the shopper. This order's own payment is unchanged."
msgstr ""
"OutlinePay가 중복 결제 %2$s를 자동으로 취소했습니다. %1$s이 구매자에게 환불되"
"었습니다. 이 주문의 결제는 그대로입니다."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay payment id.
#: includes/class-refunds.php:402
#, php-format
msgid ""
"%1$s of OutlinePay payment %2$s was refunded. That payment did not pay this "
"order, so no refund is added to it."
msgstr ""
"OutlinePay 결제 %2$s에서 %1$s이 환불되었습니다. 그 결제는 이 주문의 결제가 아"
"니므로 이 주문에는 환불이 추가되지 않습니다."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay refund id.
#: includes/class-refunds.php:466
#, php-format
msgid ""
"OutlinePay confirmed a refund of %1$s (refund %2$s), but WooCommerce could "
"not add it to this order. The order may already show this refund. Check the "
"order's refunds."
msgstr ""
"OutlinePay가 %1$s 환불을 확인했지만 (환불 %2$s) WooCommerce가 이 주문에 추가"
"하지 못했습니다. 주문에 이 환불이 이미 있을 수 있습니다. 주문의 환불 내역을 "
"확인하십시오."

#. translators: 1: amount such as 5,000 won, 2: OutlinePay refund id, 3: reason.
#: includes/class-refunds.php:494
#, php-format
msgid "OutlinePay confirmed a refund of %1$s (refund %2$s): %3$s."
msgstr "OutlinePay가 %1$s 환불을 확인했습니다 (환불 %2$s): %3$s."

#: includes/class-refunds.php:903 includes/class-shopper-cancel.php:259
msgid "Cancelled by the shopper"
msgstr "구매자 취소"

#: includes/class-refunds.php:907
msgid "Refunded in the payment provider's dashboard"
msgstr "결제대행사 관리 화면에서 환불"

#: includes/class-refunds.php:909
msgid "Duplicate payment cancelled automatically"
msgstr "중복 결제 자동 취소"

#: includes/class-refunds.php:911
